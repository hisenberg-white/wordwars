# Where the game server lives. Inlined by Vite at BUILD/START time, so changing
# it needs a restart — setting it at runtime does nothing.
VITE_SERVER_URL=http://localhost:4000

# Extra hostnames the dev server will answer to, comma-separated. Needed when
# tunnelling (ngrok, Cloudflare) because Vite rejects unknown Host headers —
# a protection against other sites reaching your dev server, so leave it empty
# unless you are actually tunnelling. A leading dot matches subdomains.
#
#   VITE_ALLOWED_HOSTS=.ngrok-free.dev
VITE_ALLOWED_HOSTS=
