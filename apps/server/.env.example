NODE_ENV=development
HOST=0.0.0.0
PORT=4000

LOG_LEVEL=debug
LOG_PRETTY=true

# Vite dev server origin
CORS_ORIGIN=http://localhost:5173

# `none`  = fully in-memory, no Docker required (phases 1-3)
# `full`  = Postgres + Redis (needed from phase 4 onward)
PERSISTENCE=none

# Read by the Prisma CLI (`pnpm db:validate`, `db:migrate`) even when
# PERSISTENCE=none. The server itself ignores these unless PERSISTENCE=full,
# so leaving them set costs nothing and keeps the schema tooling working.
DATABASE_URL=postgresql://wordwars:wordwars@localhost:5432/wordwars
REDIS_URL=redis://localhost:6379

SESSION_SECRET=dev-only-insecure-secret-change-me
SESSION_TTL_HOURS=720
